{
    "name": "doloto/big0nia",
    "description": "A standalone static analyzer that detects algorithmic-complexity and performance anti-patterns in PHP/Symfony code.",
    "type": "library",
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Khalimov Renato",
            "email": "bredevil@gmail.com"
        }
    ],
    "bin": [
        "bin/big0nia"
    ],
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Doloto\\Big0nia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doloto\\Big0nia\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
